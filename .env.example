# ─────────────────────────────────────────────
#  KageOps Environment Variables
# ─────────────────────────────────────────────
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to source control.
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# KageOps ships with an embedded Postgres (PGlite) — zero Docker required.
# Embedded mode is the default; data persists under ~/.kageops/pgdata.
#
# To use an external Postgres instead (e.g. production/team deployments),
# set DATABASE_URL below. KAGEOPS_DB_MODE explicitly overrides (embedded|external).
#
# DATABASE_URL=postgres://kageops:kageops_dev_2026@localhost:5432/kageops
# KAGEOPS_DB_MODE=external
DB_PASSWORD=kageops_dev_2026

# ── Ollama (Local AI) ────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── AI Provider API Keys ─────────────────────
# Anthropic Claude (API access)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# OpenAI (for Codex CLI / GPT models)
OPENAI_API_KEY=sk-proj-your-openai-key-here

# OpenRouter (multi-model marketplace)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Google Gemini
GOOGLE_API_KEY=your-gemini-key-here

# ── GitHub ────────────────────────────────────
GITHUB_TOKEN=ghp_your-token-here
# Default owner/repo for headless runs — Aegis pushes branches and opens PRs here.
# GITHUB_DEFAULT_OWNER=your-github-username
# GITHUB_DEFAULT_REPO=kageops_playground

# ── LiteLLM Proxy (cost intelligence) ───────
# Start LiteLLM: docker compose up -d litellm
# Set LITELLM_PROXY_URL to route ALL AI calls through the proxy and
# capture unified spend logs in Postgres (LiteLLM_SpendLogs table).
# Leave unset to use direct provider calls (no cost tracking).
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=kageops-dev-key

# ── Cost Guardrails (v1.6) ────────────────────
# Per-run hard cost cap. Headless runner kills the pipeline when
# MAX(SUM(agent_logs.cost_usd), tokens_out * $3/M) >= this value.
# Default: 0.25 (aggressive — raise for non-trivial projects on Sonnet).
KAGEOPS_MAX_RUN_USD=0.25

# Per-task hard cap on AutonautAgent.askAI calls. Default: 8.
# KAGEOPS_MAX_AI_CALLS_PER_TASK=8

# Per-agent maxTokens overrides (override the built-in caps in agent-config.ts).
# KAGEOPS_MAX_TOKENS_FORGE=6000
# KAGEOPS_MAX_TOKENS_BLUEPRINT=3072

# Zombie-project guard: abort run if no tasks decomposed within N ms.
# KAGEOPS_ZOMBIE_TIMEOUT_MS=60000

# ── Model Routing (v1.6) ──────────────────────
# Active preset. Files resolved from KAGEOPS_DATA_DIR:
#   agent-config.<preset>.json
# Valid: ollama | openrouter_budget | openrouter_standard
# Also persisted to <KAGEOPS_DATA_DIR>/active-preset.txt when set from the UI.
# KAGEOPS_PRESET=openrouter_budget

# Data directory holding .env, agent-config.*.json, active-preset.txt.
# Defaults to ~/.kageops when unset.
# KAGEOPS_DATA_DIR=/path/to/your/kageops-data

# ── Hosting & deployment (opt-in) ────────────────────────────────
# The open build runs locally by default (a green build + tests finishes a
# project on your machine). To deploy the generated app to Vercel instead:
# KAGEOPS_NO_HOSTING=0                       # 0 = enable cloud deploy (open build defaults to 1 = run-locally)
# KAGEOPS_VERCEL_TOKEN=vcp_your_token        # or store it in the OS keychain
# KAGEOPS_VERCEL_SCOPE=your-team-or-username # optional — avoids the "Loading teams…" hang
# KAGEOPS_APP_ENV_FILE=/path/to/app.env      # the BUILT app's runtime keys (Stripe/Clerk/Neon DATABASE_URL…)

# Reflector model for post-failure incident signatures.
# KAGEOPS_REFLECTOR_MODEL=openrouter/anthropic/claude-haiku-4.5

# ── APO — Automatic Prompt Optimization (v0.11 Phase 4) ──
# Nightly beam-search over prompt mutations for Scout, Herald, Pixel.
# OPT-IN: scheduler is off unless KAGEOPS_APO_ENABLED=1.
# Propose-only — winning prompts land as `proposed` rows in prompt_optimizations
# and require a human click in Command Center to accept or roll back.
# KAGEOPS_APO_ENABLED=1
# KAGEOPS_APO_EVAL_MODEL=openrouter/openai/gpt-4o-mini
# KAGEOPS_APO_MUTATOR_MODEL=claude/claude-haiku-3-5-20241022
# KAGEOPS_APO_MIN_DELTA=0.02

# ── Azure (future cloud burst) ───────────────
# AZURE_SUBSCRIPTION_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ── Communication (future) ───────────────────
# TEAMS_WEBHOOK_URL=
# AZURE_COMMUNICATION_CONNECTION_STRING=
# OUTLOOK_CLIENT_ID=

# ── Auth (Clerk) ─────────────────────────────
# Development instance (used by `npm run dev` by default)
# CLERK_PUBLISHABLE_TEST_KEY=pk_test_...
# CLERK_SECRET_TEST_KEY=sk_test_...
#
# Production instance (used when KAGEOPS_AUTH_ENV=production OR when
# CLERK_PUBLISHABLE_KEY is set and KAGEOPS_AUTH_ENV is unset)
# CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...
#
# Optional explicit toggle: production | development | auto (default)
# KAGEOPS_AUTH_ENV=production
