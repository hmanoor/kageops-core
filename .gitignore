# Cloudflare Wrangler local cache
api/.wrangler/
.wrangler/

# Local electron-builder dev output (final installers ship via CI → R2
# at dl.kageops.ai; the local releases/ tree is throwaway).
releases/

# Scratch debug scripts at repo root — naming convention is `query-*.ts`
# / `query-*.mjs` for one-off DB probes. Promote to scripts/ with a
# proper name + header comment if a probe is worth keeping.
/query-*.ts
/query-*.mjs

# Scratch project briefs + dev playground inputs under scripts/. The
# leading underscore is the convention for "don't commit me" — these
# are local experiment specs (`_donedeck-spec.txt`, `_jeeva-spec.txt`,
# etc.) that feed the headless runner during benchmarking.
scripts/_*
