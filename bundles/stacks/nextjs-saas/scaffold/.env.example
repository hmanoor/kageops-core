# ── Clerk auth (D-01) ─────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ── Neon Postgres (D-02) ──────────────────────────────────────────────
# Get from https://console.neon.tech → your project → Connection Details
# Use the pooled connection string for serverless drivers.
DATABASE_URL=

# ── Stripe payments (D-03) ────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Get from Stripe → Webhooks → endpoint → "Signing secret"
STRIPE_WEBHOOK_SECRET=
# The Stripe Price the membership checkout subscribes to (price_...).
# Create a Product + recurring Price in Stripe, paste its id here. The amount
# lives in Stripe — never hardcode a dues figure in the app copy.
STRIPE_PRICE_ID=

# ── App ───────────────────────────────────────────────────────────────
# The deployed origin, e.g. https://your-app.vercel.app — used to build the
# Stripe Checkout success/cancel URLs. Set to http://localhost:3000 for dev.
NEXT_PUBLIC_APP_URL=
