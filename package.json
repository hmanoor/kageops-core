{
  "name": "kageops-core",
  "version": "0.5.0",
  "description": "KageOps Core — open-source multi-agent orchestration engine (idea → shipped product)",
  "homepage": "https://kageops.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/hmanoor/kageops-core.git"
  },
  "main": "dist/main/main.js",
  "author": "KageOps",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "build": "tsc && npm run build:assets && npm run build:renderer",
    "build:assets": "node scripts/copy-assets.js",
    "build:renderer": "esbuild src/renderer/command-center/command-center.ts --bundle --outfile=dist/renderer/command-center/command-center.js --platform=browser --format=iife --sourcemap --loader:.md=text && esbuild src/renderer/plan/plan.ts --bundle --outfile=dist/renderer/plan/plan.js --platform=browser --format=iife --sourcemap && esbuild src/renderer/welcome/welcome.ts --bundle --outfile=dist/renderer/welcome/welcome.js --platform=browser --format=iife --sourcemap",
    "start": "npm run build && node scripts/launch-electron.js",
    "dev": "npm run build && node scripts/launch-electron.js",
    "dev:watch": "npm run build:assets && concurrently --names \"TSC,ESBUILD,ELECTRON\" --prefix-colors \"cyan,yellow,green\" \"tsc --watch --preserveWatchOutput\" \"esbuild src/renderer/command-center/command-center.ts --bundle --outfile=dist/renderer/command-center/command-center.js --platform=browser --format=iife --sourcemap --loader:.md=text --watch\" \"wait-on dist/main/main.js && node scripts/launch-electron.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e",
    "ci": "npm run ci:lint && npm run ci:build && npm run ci:test",
    "ci:lint": "npx tsc --noEmit --strict",
    "ci:build": "npm run build",
    "ci:test": "vitest run",
    "run:headless": "npx tsx src/cli/headless-runner.ts",
    "secret-scan": "npx tsx scripts/secret-scan.ts --staged",
    "secret-scan:all": "npx tsx scripts/secret-scan.ts --all",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@azure/arm-appservice": "^16.0.0",
    "@azure/arm-containerinstance": "^9.1.0",
    "@azure/arm-containerregistry": "^10.1.0",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.0",
    "@clerk/backend": "^3.4.5",
    "@electric-sql/pglite": "^0.4.4",
    "@supabase/supabase-js": "^2.105.3",
    "@types/pg": "^8.20.0",
    "@types/prismjs": "1.26.5",
    "@types/semver": "^7.7.1",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "electron-updater": "^6.8.3",
    "keytar": "^7.9.0",
    "marked": "^15.0.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prismjs": "1.30.0",
    "semver": "^7.8.1",
    "v0-sdk": "^0.16.4",
    "yaml": "^2.9.0",
    "zip-stream": "^6.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/archiver": "^6.0.4",
    "@types/jsdom": "^28.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.0",
    "jose": "^5.10.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wait-on": "^9.0.5"
  }
}
